# ImpactLedger — root .env template (see docs/deployment.md).
# Copy to .env and fill in. Never commit the .env.

# ---------- Supabase ----------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---------- Backend ----------
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------- Frontend ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------- Blockchain anchor (ADR-011, ADR-012) ----------
ANCHOR_ADAPTER=noop
ANCHOR_CHAIN_ID=84532
ANCHOR_RPC_URL=https://sepolia.base.org
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_RUNTIME_PRIVATE_KEY=
ANCHOR_DEPLOYER_PRIVATE_KEY=
ANCHOR_BATCH_INTERVAL_SECONDS=300
ANCHOR_MAX_PENDING_EVENTS=512
ANCHOR_CONFIRMATIONS_REQUIRED=2
BASESCAN_API_KEY=

# ---------- OCR / LLM interfaces (default: no-op) ----------
OCR_PROVIDER=noop
LLM_PROVIDER=noop
